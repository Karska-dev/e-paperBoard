# EditorConfig: basic whitespace rules that most editors pick up
# automatically (https://editorconfig.org), so files look the same whoever
# edits them and diffs contain no accidental whitespace changes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2

# Two trailing spaces mean "line break" in Markdown, so do not strip them.
[*.md]
trim_trailing_whitespace = false
